# Normalise to LF in the repository, check out native on Windows.
* text=auto

# LF in the working tree too: run by Linux tooling whatever the developer's OS.
*.sh              text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.sql             text eol=lf

*.ps1             text eol=crlf
*.cmd             text eol=crlf
*.bat             text eol=crlf

# Diffable but never merged.
pnpm-lock.yaml    text eol=lf -diff
package-lock.json text eol=lf -diff

*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.jar    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
