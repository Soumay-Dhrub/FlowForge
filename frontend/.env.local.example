# Copy to .env.local for `pnpm dev`. All optional: with no .env.local the frontend calls /api, which
# next.config.mjs rewrites to http://localhost:8080.

# Fallback rewrite target, read by next.config.mjs rather than by application code.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where Next.js proxies /api/* to. Build-time only: Next freezes rewrite destinations into
# routes-manifest.json, so setting it on a running container has no effect. docker-compose passes it
# as a build arg defaulting to http://backend:8080.
API_PROXY_TARGET=http://localhost:8080

# Base URL for the axios client. Leave unset — the default "/api" is same-origin, and the backend has
# no CORS configuration, so an absolute cross-origin value needs CORS added to SecurityConfig first.
# NEXT_PUBLIC_API_BASE_URL=/api
