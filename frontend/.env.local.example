# Copy to .env.local for `pnpm dev`. Not used by the Docker image — see below.

# Where the browser reaches the backend when running the dev server directly.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where Next.js proxies /api/* to, used by the rewrite in next.config.mjs.
#
# This is a BUILD-time value in the Docker image, not a runtime one: Next resolves
# rewrite destinations during `next build` and freezes them into
# routes-manifest.json, so setting it as a container environment variable has no
# effect. docker-compose passes it as a build arg (default http://backend:8080,
# the service name on the compose network). Inside the frontend container
# "localhost" is the frontend itself, which is why it cannot be used here.
API_PROXY_TARGET=http://localhost:8080
