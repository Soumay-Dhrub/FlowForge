# Copy to .env.local for `pnpm dev`. Not used by the Docker image — see below.
#
# Every value here is optional: with no .env.local the frontend calls the relative path /api, which
# next.config.mjs rewrites to http://localhost:8080. That is the correct setup for local
# development and needs no configuration.

# Where the browser reaches the backend when running the dev server directly.
#
# Read by next.config.mjs as the fallback rewrite target, NOT by the application code. Setting it
# to a different host changes where the Next.js server proxies /api/* to; it does not change the
# URL the browser requests.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where Next.js proxies /api/* to, used by the rewrite in next.config.mjs.
#
# This is a BUILD-time value in the Docker image, not a runtime one: Next resolves
# rewrite destinations during `next build` and freezes them into
# routes-manifest.json, so setting it as a container environment variable has no
# effect. docker-compose passes it as a build arg (default http://backend:8080,
# the service name on the compose network). Inside the frontend container
# "localhost" is the frontend itself, which is why it cannot be used here.
API_PROXY_TARGET=http://localhost:8080

# Base URL the axios client prefixes onto every request (frontend/src/lib/api.ts).
#
# Leave it unset. The default is the relative "/api", which keeps the browser on one origin and
# means the application needs no CORS configuration at all — and the backend deliberately has
# none, so a same-origin path is not merely the tidier option.
#
# Point it at an absolute cross-origin URL only if you also add a CORS configuration to
# SecurityConfig, otherwise every request fails the browser's preflight check. It exists as an
# escape hatch for deployments that cannot use the rewrite; it is not part of the normal setup.
# NEXT_PUBLIC_API_BASE_URL=/api
