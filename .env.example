# Copy to .env and adjust. docker-compose reads .env automatically.
#
# Everything here has a working default, so `docker compose up` runs with no .env at all. Copy this
# file when you want to change a port, point at an external database, or — before exposing the stack
# to anyone — set a real JWT_SECRET.
#
# Scope note: the variables under "Database", "JWT", "Mail", "Attachments" and "Application URLs"
# are read by the Spring Boot backend (see backend/src/main/resources/application.yml). The
# POSTGRES_*, *_PORT and PGADMIN_* ones are consumed by docker-compose itself. When you run the
# backend directly with Maven instead of Compose, Compose is not involved, so set DB_URL /
# DB_USERNAME / DB_PASSWORD rather than the POSTGRES_* pair.

# ── Optional dev services ────────────────────────────────────────
# pgAdmin and MailHog are gated behind the "dev" profile so a plain
# `docker compose up` runs only the application. Uncomment to start them too,
# which is equivalent to passing `--profile dev` on every command.
# An override file cannot do this: `profiles: []` does not clear a profile in
# Compose v2, it inherits the base value, so a file that looks like it un-gates
# them silently does nothing.
# COMPOSE_PROFILES=dev

# ── Database (docker-compose) ────────────────────────────────────
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
# 5432 is often already taken by a locally installed Postgres. If `docker compose
# up` reports the port is allocated, or the backend cannot see its own database,
# set this to something free such as 5433 — the container's internal port is
# unchanged, so nothing else needs adjusting.
POSTGRES_PORT=5432

# ── Database (backend, when NOT using docker-compose) ────────────
# Compose builds DB_URL from the POSTGRES_* values above and points it at the "postgres" service,
# so leave these alone for a Compose run. Set them when starting the backend directly
# (`mvn spring-boot:run`), where "postgres" is not a resolvable hostname.
# DB_URL=jdbc:postgresql://localhost:5432/flowforge
# DB_USERNAME=flowforge
# DB_PASSWORD=flowforge

# ── Backend ──────────────────────────────────────────────────────
BACKEND_PORT=8080

# ── First-run administrator ──────────────────────────────────────
# A clean database contains the three roles and the General department but no users, and there is
# no public registration endpoint — creating a user requires an existing ADMIN. So on first start
# the backend creates one administrator, and only while the users table is empty. It never touches
# an installation that already has users, so this is safe to leave enabled.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@flowforge.local
# Leave blank and a strong random password is generated and printed once in the startup log:
#   docker compose logs backend | grep -A6 "first administrator"
# Set it to choose your own instead. Blank is the safer default — a value committed here would be
# a known password on every deployment. Whatever you use must be 8-72 characters.
BOOTSTRAP_ADMIN_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────
# CHANGE THIS before anyone else can reach the instance. The value below is published in this
# repository, so leaving it in place means anyone can forge a valid token for any account,
# including an administrator's. It only needs to be private and at least 32 characters; the
# backend refuses to start on anything shorter and logs a SECURITY warning while this
# placeholder is still in use.
#   macOS/Linux:  openssl rand -base64 48
#   Windows:      [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET=change-me-in-production-must-be-at-least-256-bits-long-secret
# Access token lifetime (15 minutes).
JWT_ACCESS_EXPIRY_MS=900000
# Refresh token lifetime. 2592000000 is 30 days; the backend's own default is 7 days
# (604800000). Refresh tokens are single-use and rotate on every refresh.
JWT_REFRESH_EXPIRY_MS=2592000000

# ── Mail ─────────────────────────────────────────────────────────
# Defaults target MailHog (see COMPOSE_PROFILES above), which accepts anything on 1025 and shows
# captured mail at http://localhost:8025. Nothing is delivered to real inboxes. Leave the
# credentials blank for MailHog; a real SMTP relay will need them.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
# Envelope sender on outgoing notification mail.
MAIL_FROM=no-reply@flowforge.local

# ── Application URLs ─────────────────────────────────────────────
# Where links in notification and password-reset emails point, i.e. the address a recipient's
# browser can reach the frontend on. The localhost defaults are correct for local development and
# wrong for any real deployment, where they must be the public frontend URL.
WEB_BASE_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
# Password reset token lifetime. Capped at 24h by the backend; larger values are clamped.
PASSWORD_RESET_EXPIRY_MS=86400000

# ── Attachments ──────────────────────────────────────────────────
# Per-file limit enforced by the application while writing bytes (10 MiB).
ATTACHMENT_MAX_SIZE=10485760
# Servlet container limits, deliberately set ABOVE ATTACHMENT_MAX_SIZE. A file between the two is
# refused by the application with a 413 that names the limit; were these lower, the upload would
# be cut off before any of that could run.
ATTACHMENT_MAX_UPLOAD_SIZE=11MB
ATTACHMENT_MAX_REQUEST_SIZE=12MB
# Where attachment bytes are stored. Relative paths resolve against the backend's working
# directory. Compose overrides this to /app/var/attachments and mounts a named volume there so
# uploads survive a container rebuild; only metadata lives in PostgreSQL.
# ATTACHMENT_STORAGE_PATH=./var/attachments

# ── Frontend ─────────────────────────────────────────────────────
FRONTEND_PORT=3000
# Frontend build/runtime settings live in frontend/.env.local.example — Next.js inlines
# NEXT_PUBLIC_* values at build time, so they cannot be set from this file for the Docker image.

# ── pgAdmin (dev only) ───────────────────────────────────────────
PGADMIN_EMAIL=admin@flowforge.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
