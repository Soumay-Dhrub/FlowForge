# Copy to .env and adjust. docker-compose reads .env automatically.
# Every value has a working default, so `docker compose up` runs without a .env.

# Starts pgAdmin and MailHog alongside the app.
# COMPOSE_PROFILES=dev

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_PORT=5432

# Compose derives DB_URL from the values above. Set these only when running the backend outside
# Compose, where the "postgres" hostname does not resolve.
# DB_URL=jdbc:postgresql://localhost:5432/flowforge
# DB_USERNAME=flowforge
# DB_PASSWORD=flowforge

# ── Backend ──────────────────────────────────────────────────────
BACKEND_PORT=8080

# ── First-run administrator ──────────────────────────────────────
# Created only while the users table is empty. Blank password generates one and logs it:
#   docker compose logs backend | grep -A6 "first administrator"
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@flowforge.local
BOOTSTRAP_ADMIN_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────
# Change before exposing the instance: this value is published in the repository, so tokens signed
# with it can be forged. Needs 32+ characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-must-be-at-least-256-bits-long-secret
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=2592000000

# ── Mail ─────────────────────────────────────────────────────────
# Defaults target MailHog; nothing reaches real inboxes. Captured mail is on port 8025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@flowforge.local

# ── Application URLs ─────────────────────────────────────────────
# Used in notification and password-reset email links.
WEB_BASE_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_EXPIRY_MS=86400000

# ── Attachments ──────────────────────────────────────────────────
ATTACHMENT_MAX_SIZE=10485760
# Servlet limits, deliberately above ATTACHMENT_MAX_SIZE so an oversized file gets a 413 naming the
# limit rather than a truncated stream.
ATTACHMENT_MAX_UPLOAD_SIZE=11MB
ATTACHMENT_MAX_REQUEST_SIZE=12MB
# ATTACHMENT_STORAGE_PATH=./var/attachments

# ── Frontend ─────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── pgAdmin (dev profile) ────────────────────────────────────────
PGADMIN_EMAIL=admin@flowforge.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
